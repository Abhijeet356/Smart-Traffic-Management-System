# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Local MongoDB or MongoDB Atlas URI)
# Example Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/smart_traffic_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_traffic_db

# JWT Authentication
JWT_SECRET=smart_traffic_super_secret_jwt_key_academic_project_2026
JWT_EXPIRES_IN=7d

# Traffic Simulation Settings
SIMULATION_INTERVAL_MS=10000
AUTO_SIMULATION=true

# Traffic Density Thresholds (%)
LOW_DENSITY_MAX=30
MEDIUM_DENSITY_MAX=60
HIGH_DENSITY_MAX=80
